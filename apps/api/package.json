{
  "name": "@fresh-mercy/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":        "tsx watch --clear-screen=false src/index.ts",
    "build":      "prisma generate --schema=prisma/schema.prisma && tsc",
    "start":      "node dist/index.js",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed":    "npx tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client":      "6.7.0",
    "prisma":              "6.7.0",
    "argon2":              "0.41.1",
    "cors":                "2.8.5",
    "dotenv":              "16.4.7",
    "express":             "4.21.2",
    "express-rate-limit":  "7.5.0",
    "helmet":              "8.0.0",
    "jsonwebtoken":        "9.0.2",
    "nodemailer":          "6.10.0",
    "pino":                "9.6.0",
    "pino-pretty":         "13.0.0",
    "zod":                 "3.24.1",
    "uuid":                "11.0.5",
    "tsx":                 "4.19.2",
    "typescript":          "5.7.3",
    "@types/cors":         "2.8.17",
    "@types/express":      "5.0.0",
    "@types/jsonwebtoken": "9.0.8",
    "@types/nodemailer":   "6.4.17",
    "@types/node":         "22.13.0",
    "@types/uuid":         "10.0.0"
  },
  "devDependencies": {
    "vitest": "2.1.8"
  }
}

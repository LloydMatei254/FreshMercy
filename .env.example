# ============================================================
# FRESH MERCY — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/freshmercy?schema=public"

# ── API SERVER ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS / FRONTEND URL ───────────────────────────────────────
# The URL of the frontend app (used for CORS and email links)
FRONTEND_URL=http://localhost:5173

# ── JWT / SESSION ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_chars
JWT_EXPIRES_IN=7d

# ── EMAIL ─────────────────────────────────────────────────────
# Provider: resend | sendgrid | mailgun | smtp | console (development)
EMAIL_PROVIDER=console

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMTP (generic)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From address shown on all outgoing emails
EMAIL_FROM="Fresh Mercy <hello@freshmercy.org>"
EMAIL_REPLY_TO=hello@freshmercy.org

# Admin notification email (receives contact form messages, prayer request alerts)
ADMIN_EMAIL=admin@freshmercy.org

# ── ADMIN SETUP ────────────────────────────────────────────────
# Used by the seed script to create the first admin user
SEED_ADMIN_EMAIL=admin@freshmercy.org
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_NAME=Fresh Mercy Admin

# ── ANALYTICS ─────────────────────────────────────────────────
# Provider: google | plausible | umami | none
ANALYTICS_PROVIDER=none
ANALYTICS_ID=

# ── RATE LIMITING ──────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter limits for form submissions
FORM_RATE_LIMIT_WINDOW_MS=3600000
FORM_RATE_LIMIT_MAX=10

# ── SOCIAL MEDIA (optional) ────────────────────────────────────
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=
TIKTOK_URL=
WHATSAPP_COMMUNITY_URL=

# ── COMMUNITY LINKS (optional) ─────────────────────────────────
DISCORD_URL=
TELEGRAM_URL=

# ── PWA ───────────────────────────────────────────────────────
# Base URL for the deployed frontend (used in manifest and sitemap)
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

# ── FEATURE FLAGS ─────────────────────────────────────────────
VITE_FEATURE_PRAYER=true
VITE_FEATURE_COMMUNITY=true
VITE_FEATURE_NEWSLETTER=true
VITE_FEATURE_SEARCH=true
